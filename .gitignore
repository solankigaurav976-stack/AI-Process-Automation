# .gitignore for AI-Process-Automation
# Based on the reviewed dashboard/docs/proposed_root.gitignore.

# --- Data: kept local (public dataset, too large for Git) ---
# The raw XES is ~552 MB (above GitHub's 100 MB file limit). The processed Parquet
# (~24 MB) is derived from it with src/ingest_data.py. Download the dataset from
# https://doi.org/10.4121/uuid:5f3067df-f10b-45da-b98b-86ae4c7a310b instead.
data/raw/
data/processed/
# Safety net: never commit a copy of the event log placed anywhere else.
*.xes
*.parquet

# --- Python environment and caches ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Secrets (none exist today; never commit them) ---
.streamlit/secrets.toml
**/.streamlit/secrets.toml
.env
.env.*

# --- OS / editor files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
